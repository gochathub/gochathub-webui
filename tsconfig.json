{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": [
      "ESNext",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "paths": {
      "harper.js": ["./node_modules/harper.js/dist/index.d.ts"],
      "harper.js/binary": ["./node_modules/harper.js/dist/binary.d.ts"],
      "*": [
        "./src/client/@custom_types/*"
      ],
      "@src/*": [
        "./src/*"
      ],
      "@custom_types/*": [
        "./src/@custom_types/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}